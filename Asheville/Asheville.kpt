   <plugin id="progressbar" name="tr:Progress Bar and Loopings">
    <param default="True" uiPreview="false" customize="false" id="showloadVisible" name="tr:Display loading bar"/>
    <param conditionalParam="showloadVisible" conditionalValues="true" uiPreview="false" customize="false" id="showload" name="tr:Loading bar">
     <position availableValues="topleft,left,bottomleft,top,center,bottom,topright,right,bottomright" needOrientation="false" x="0" y="0" xUnit="pixel" default="bottom" yUnit="pixel" uiPreview="false" customize="false" yUnits="pixel" defaultOrientation="horizontal" xUnits="pixel" id="showloadPosition" name="tr:Position"/>
     <size uiPreview="false" customize="false" needKeepRatio="false" id="size" name="tr:Bar size">
      <dimension default="100" minimum="0" currentUnit="percent" maximum="9999" uiPreview="false" customize="false" availableUnits="percent,pixel" needAutomatic="false" id="width" name="tr:Width"/>
      <dimension default="5" minimum="0" currentUnit="pixel" maximum="9999" uiPreview="false" customize="false" availableUnits="percent,pixel" needAutomatic="false" id="height" name="tr:Height"/>
     </size>
     <group uiPreview="false" customize="false" id="showloadFill" name="tr:Bar color">
      <color default="#ffffff" allowDynamicSource="false" uiPreview="false" customize="false" needAlpha="false" id="backColor" source="customColor" name="tr:Background color"/>
      <color default="#555555" allowDynamicSource="false" uiPreview="false" customize="false" needAlpha="false" id="loadColor" source="customColor" name="tr:Load color"/>
     </group>
    </param>
    <param default="True" uiPreview="false" customize="false" id="showwaitVisible" name="tr:Display Looping wheel"/>
