        <color default="#ffffff" conditionalParam="showloadGlow" conditionalValues="true" allowDynamicSource="false" uiPreview="false" customize="false" needAlpha="false" id="showloadGlowcolor" source="customColor" name="tr:Glow color"/>
       </row>
      </group>
      <group uiPreview="false" customize="false" id="showloadFillAdvanced" name="tr:Bar color">
       <bool default="False" uiPreview="false" customize="false" id="shadedStyle" name="tr:Display inner glow"/>
      </group>
     </group>
     <group conditionalParam="showwaitVisible" conditionalValues="true" uiPreview="false" customize="false" id="showwaitadvanced" name="tr:Looping wheel">
      <group uiPreview="false" customize="false" id="showwaitParamsAdvanced" name="tr:Dots of looping wheel">
