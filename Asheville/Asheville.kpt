   <plugin id="title" name="Panorama Title">
    <param uiPreview="false" customize="false" id="position_group" name="tr:Position">
     <position availableValues="topleft,topright,top,bottomleft,bottomright,bottom" needOrientation="false" x="10" y="15" xUnit="pixel" default="topright" yUnit="pixel" uiPreview="false" customize="false" yUnits="pixel" defaultOrientation="horizontal" xUnits="pixel" id="position" name="tr:Position"/>
    </param>
    <param uiPreview="false" customize="false" id="display" name="tr:Display">
     <datasource default="currentpanorama" uiPreview="false" customize="false" id="source" name="tr:Title to display"/>
     <font size="20" default="Baskerville" uiPreview="false" customize="false" style="" id="font" name="tr:Font style"/>
     <color default="#000000" allowDynamicSource="false" uiPreview="false" customize="false" needAlpha="true" id="color" source="customColor" name="tr:Font color" defaultAlpha="1"/>
     <bool default="False" uiPreview="false" customize="false" id="hasshadow" name="tr:Drop shadow text"/>
    </param>
    <param uiPreview="false" customize="false" id="behavior" name="tr:Behavior">
     <bool default="True" description="tr:Show/hide this component when the user triggers a show/hide controls request from an other component" uiPreview="false" customize="false" id="hideonhidecontrols" name="tr:Respond to show/hide controls requests"/>
    </param>
   </plugin>
   <plugin id="description" name="Description">
    <param uiPreview="false" customize="false" id="position_group" name="tr:Position">
     <position availableValues="topleft,topright,top,bottomleft,bottomright,bottom,left,right,center" needOrientation="false" x="0" y="0" xUnit="pixel" default="topleft" yUnit="pixel" uiPreview="false" customize="false" yUnits="pixel" defaultOrientation="horizontal" xUnits="pixel" id="position" name="tr:Position"/>
    </param>
    <param uiPreview="false" customize="false" id="display" name="tr:Display">
     <datasource default="currentproject" uiPreview="false" customize="false" id="source" name="tr:Description to display"/>
     <bool default="False" conditionalParam="source" conditionalValues="currentgroup" description="tr:Use the current group color as background color" uiPreview="false" customize="false" id="use_group_color" name="tr:Use group color"/>
     <dimension default="50" minimum="0" currentUnit="percent" maximum="9999" uiPreview="false" customize="false" availableUnits="percent,pixel" needAutomatic="false" id="area_width" name="tr:Area width"/>
     <dimension default="50" minimum="0" currentUnit="percent" maximum="9999" uiPreview="false" customize="false" availableUnits="percent,pixel" needAutomatic="false" id="area_height" name="tr:Area height"/>
     <color default="#000000" allowDynamicSource="false" uiPreview="false" customize="false" needAlpha="true" id="background_color" source="customColor" name="tr:Background color" defaultAlpha="0"/>
     <dimension default="0" minimum="0" currentUnit="pixel" maximum="100" uiPreview="false" customize="false" availableUnits="pixel" needAutomatic="false" id="border_radius" name="tr:Border radius"/>
     <dimension default="0" minimum="0" currentUnit="pixel" maximum="100" uiPreview="false" customize="false" availableUnits="pixel" needAutomatic="false" id="border_width" name="tr:Border size"/>
     <color default="#f2f2f2" allowDynamicSource="false" uiPreview="false" customize="false" needAlpha="false" id="border_color" source="customColor" name="tr:Border color"/>
     <dimension default="10" minimum="0" currentUnit="pixel" maximum="100" uiPreview="false" customize="false" availableUnits="pixel" needAutomatic="false" id="border_margins" name="tr:Internal margins"/>
    </param>
    <param uiPreview="false" customize="false" id="overlay" name="tr:Overlay style">
     <bool default="False" description="tr:Check to show a coloured overlay" uiPreview="false" customize="false" id="overlay_displayed" name="tr:Show overlay"/>
     <color default="#000000" conditionalParam="overlay_displayed" conditionalValues="true" allowDynamicSource="false" uiPreview="false" customize="false" needAlpha="true" id="overlay_color" source="customColor" name="tr:Overlay color" defaultAlpha="0.5"/>
    </param>
    <param uiPreview="false" customize="false" id="title" name="tr:Description title">
     <bool default="False" uiPreview="false" customize="false" id="display_title" name="tr:Display a description title"/>
     <datasource default="currentpanorama" conditionalParam="display_title" conditionalValues="true" uiPreview="false" customize="false" id="description_title_source" name="tr:Description title to display"/>
     <string needTranslation="true" default="" conditionalParam="display_title" conditionalValues="true" uiPreview="false" customize="false" id="description_title" name="tr:Specific description title"/>
     <font size="14" default="Verdana" conditionalParam="display_title" conditionalValues="true" uiPreview="false" customize="false" style="" id="title_font" name="tr:Title font style"/>
     <color default="#000000" conditionalParam="display_title" conditionalValues="true" allowDynamicSource="false" uiPreview="false" customize="false" needAlpha="false" id="title_color" source="customColor" name="tr:Title font color"/>
    </param>
    <param uiPreview="false" customize="false" id="behavior" name="tr:Behavior">
     <bool default="True" description="tr:The tour starts with the description opened" uiPreview="false" customize="false" id="open_at_start" name="tr:Start opened"/>
     <bool default="False" description="tr:Show/hide this component when the user triggers a show/hide controls request from an other component" uiPreview="false" customize="false" id="hide_on_hide_controls" name="tr:Respond to show/hide controls requests"/>
     <bool default="True" uiPreview="false" customize="false" id="listen_info_event" name="tr:Interact with tour info events"/>
    </param>
    <param uiPreview="false" customize="false" id="">
     <bool default="False" uiPreview="false" customize="false" id="display_close" name="tr:Display a close button"/>
     <bool default="False" uiPreview="false" customize="false" id="close_on_click" name="tr:Close description on click"/>
     <bool default="False" uiPreview="false" customize="false" id="animation" name="tr:Use animation to show description"/>
     <number suffix=" ms" default="500" minimum="0" conditionalParam="animation" conditionalValues="true" maximum="99999" uiPreview="false" customize="false" id="animation_duration" name="tr:Animation duration"/>
     <select default="left" conditionalParam="animation" conditionalValues="true" uiPreview="false" customize="false" id="start_position" name="tr:Start position">
      <item value="top" name="Top"/>
      <item value="right" name="Right"/>
      <item value="bottom" name="Bottom"/>
      <item value="left" name="Left"/>
