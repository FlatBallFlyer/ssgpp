     <position availableValues="topleft,topright,bottomleft,bottomright,top,bottom,left,right,center" needOrientation="false" x="0" y="0" xUnit="pixel" default="center" yUnit="pixel" uiPreview="false" customize="false" yUnits="pixel" defaultOrientation="horizontal" xUnits="pixel" id="showwaitPosition" name="tr:Position"/>
     <group uiPreview="false" customize="false" id="showwaitParams" name="tr:Dots of looping wheel">
